# Collections Performance Forensics - Environment Configuration Template
# Copy to .env for local overrides if needed

# Storage and Database paths
DATA_DIR=data
DUCKDB_PATH=data/golden/collections_forensics.duckdb
RAW_DATA_PATH=data/raw
OUTPUTS_PATH=outputs

# Ingestion & Processing Settings
LOG_LEVEL=INFO
DEFAULT_TIMEZONE=Asia/Kolkata
ATTRIBUTION_WINDOW_DAYS=14
DEFAULT_CURRENCY=INR

# Investment Simulation
DEFAULT_INVESTMENT_AMOUNT_CR=10.0
